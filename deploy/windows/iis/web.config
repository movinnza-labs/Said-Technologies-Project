<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy to the Node service on 127.0.0.1:3000.
  Needs the IIS "URL Rewrite" and "Application Request Routing" modules plus the one-time
  server setup in deploy\windows\README.md. Put this file in the IIS site's physical folder
  (an empty folder such as D:\SaidTechnologies\iis), not in the app folder.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}{UNENCODED_URL}" appendQueryString="false" redirectType="Permanent" />
        </rule>
        <rule name="Proxy to Next.js" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
          <!-- UNENCODED_URL keeps the original path and query exactly as the browser sent them -->
          <action type="Rewrite" url="http://127.0.0.1:3000{UNENCODED_URL}" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering allowDoubleEscaping="true">
        <!-- Resumes up to 5 MB and CMS image uploads -->
        <requestLimits maxAllowedContentLength="31457280" />
        <!-- Let Next.js handle every path (IIS hides "bin", "App_Data" etc. by default) -->
        <hiddenSegments>
          <clear />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <!-- Next.js already compresses and sets caching headers -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
