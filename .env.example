# ─────────────────────────────────────────────────────────────
# SAID Technologies website: environment variables
# Copy to .env for local development. On Railway, set these in the
# web service's Variables tab (never commit real values).
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# On Railway, reference the Postgres service's PRIVATE url (*.railway.internal):
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Never use DATABASE_PUBLIC_URL at runtime: public traffic is billed as egress.
# The build does not need the database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/said

# Long random string used to sign CMS sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me

# Public site URL with no trailing slash. Used for canonical URLs, the sitemap,
# Open Graph tags and CMS CORS. On Railway you can use https://${{RAILWAY_PUBLIC_DOMAIN}}
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Where uploaded images and resumes are stored. On Railway, mount a volume here
# (e.g. /app/media) so uploads survive redeploys.
MEDIA_DIR=media

# Set to "false" on staging so search engines don't index it.
NEXT_PUBLIC_ALLOW_INDEXING=true

# Optional: database pool size (default 5; 5–10 is plenty for this site).
# DATABASE_POOL_MAX=5

# Limits native memory growth from sharp. Already set in the Dockerfile;
# add it to the Railway service variables too if you build without Docker.
# MALLOC_ARENA_MAX=2

# ── Email notifications for new enquiries (optional) ─────────
# Without SMTP_HOST, emails are written to the server log instead of sent.
# ENQUIRY_NOTIFY_EMAIL=enquiries@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_ADDRESS=no-reply@example.com
# SMTP_FROM_NAME=SAID Technologies Website

# ── Seed (first run only) ────────────────────────────────────
# Creates the first CMS admin when seeding an empty database.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=use-a-strong-password
# Enables the one-time POST /next/seed endpoint on Railway (16+ characters).
# Remove it after seeding.
# SEED_SECRET=
